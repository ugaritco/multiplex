{
  "name": "@ugarit/multiplex",
  "version": "1.00.00",
  "description": "A tabbed TUI for running multiple commands simultaneously with searchable, scrollable output",
  "keywords": [
    "tui",
    "terminal",
    "cli",
    "multiplexer",
    "process-manager",
    "ink",
    "ugarit"
  ],
  "homepage": "https://github.com/ugarit/multiplex#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ugarit/multiplex.git"
  },
  "bugs": {
    "url": "https://github.com/ugarit/multiplex/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Taylor Otwell"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "bin": {
    "multiplex": "dist/cli.js"
  },
  "main": "dist/multiplex.js",
  "types": "dist/multiplex.d.ts",
  "exports": {
    ".": {
      "types": "./dist/multiplex.d.ts",
      "default": "./dist/multiplex.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "tsc",
    "test": "tsx --test src/*.test.ts",
    "check": "biome check --write",
    "lint": "biome lint",
    "format": "biome format --write",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "ansi-styles": "^7.0.0",
    "commander": "^15.0.0",
    "ink": "^7.1.0",
    "react": "^19.3.0",
    "string-width": "^8.2.2",
    "wrap-ansi": "^10.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^26.6.0",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "os": [
    "darwin",
    "linux"
  ]
}
